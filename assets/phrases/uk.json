[{"text": "Привіт.", "translation": "Hello."}, {"text": "Доброго ранку.", "translation": "Good morning."}, {"text": "Доброго вечора.", "translation": "Good evening."}, {"text": "Дякую.", "translation": "Thank you."}, {"text": "Будь ласка.", "translation": "You're welcome."}, {"text": "Будь ласка.", "translation": "Please."}, {"text": "Так.", "translation": "Yes."}, {"text": "Ні.", "translation": "No."}, {"text": "Перепрошую.", "translation": "Excuse me."}, {"text": "Як справи?", "translation": "How are you?"}, {"text": "Мене звати...", "translation": "My name is..."}, {"text": "Де туалет?", "translation": "Where is the bathroom?"}, {"text": "Я не розумію.", "translation": "I don't understand."}, {"text": "До побачення.", "translation": "Goodbye."}]