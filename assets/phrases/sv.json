[{"text": "Hej.", "translation": "Hello."}, {"text": "God morgon.", "translation": "Good morning."}, {"text": "God kväll.", "translation": "Good evening."}, {"text": "Tack.", "translation": "Thank you."}, {"text": "Varsågod.", "translation": "You're welcome."}, {"text": "Snälla.", "translation": "Please."}, {"text": "Ja.", "translation": "Yes."}, {"text": "Nej.", "translation": "No."}, {"text": "Ursäkta mig.", "translation": "Excuse me."}, {"text": "Hur mår du?", "translation": "How are you?"}, {"text": "Jag heter...", "translation": "My name is..."}, {"text": "Var är toaletten?", "translation": "Where is the bathroom?"}, {"text": "Jag förstår inte.", "translation": "I don't understand."}, {"text": "Hej då.", "translation": "Goodbye."}]