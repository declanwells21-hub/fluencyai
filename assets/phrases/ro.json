[{"text": "Salut.", "translation": "Hello."}, {"text": "Bună dimineața.", "translation": "Good morning."}, {"text": "Bună seara.", "translation": "Good evening."}, {"text": "Mulțumesc.", "translation": "Thank you."}, {"text": "Cu plăcere.", "translation": "You're welcome."}, {"text": "Te rog.", "translation": "Please."}, {"text": "Da.", "translation": "Yes."}, {"text": "Nu.", "translation": "No."}, {"text": "Scuzați-mă.", "translation": "Excuse me."}, {"text": "Ce mai faci?", "translation": "How are you?"}, {"text": "Numele meu este...", "translation": "My name is..."}, {"text": "Unde este baia?", "translation": "Where is the bathroom?"}, {"text": "Nu înțeleg.", "translation": "I don't understand."}, {"text": "La revedere.", "translation": "Goodbye."}]