[{"text": "שלום.", "translation": "Hello."}, {"text": "בוקר טוב.", "translation": "Good morning."}, {"text": "ערב טוב.", "translation": "Good evening."}, {"text": "תודה.", "translation": "Thank you."}, {"text": "בבקשה.", "translation": "You're welcome."}, {"text": "בבקשה.", "translation": "Please."}, {"text": "כן.", "translation": "Yes."}, {"text": "לא.", "translation": "No."}, {"text": "סליחה.", "translation": "Excuse me."}, {"text": "מה שלומך?", "translation": "How are you?"}, {"text": "קוראים לי...", "translation": "My name is..."}, {"text": "איפה השירותים?", "translation": "Where is the bathroom?"}, {"text": "אני לא מבין.", "translation": "I don't understand."}, {"text": "להתראות.", "translation": "Goodbye."}]