[{"text": "Merhaba.", "translation": "Hello."}, {"text": "Günaydın.", "translation": "Good morning."}, {"text": "İyi akşamlar.", "translation": "Good evening."}, {"text": "Teşekkür ederim.", "translation": "Thank you."}, {"text": "Rica ederim.", "translation": "You're welcome."}, {"text": "Lütfen.", "translation": "Please."}, {"text": "Evet.", "translation": "Yes."}, {"text": "Hayır.", "translation": "No."}, {"text": "Affedersiniz.", "translation": "Excuse me."}, {"text": "Nasılsın?", "translation": "How are you?"}, {"text": "Benim adım...", "translation": "My name is..."}, {"text": "Tuvalet nerede?", "translation": "Where is the bathroom?"}, {"text": "Anlamıyorum.", "translation": "I don't understand."}, {"text": "Hoşça kal.", "translation": "Goodbye."}]