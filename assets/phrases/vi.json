[{"text": "Xin chào.", "translation": "Hello."}, {"text": "Chào buổi sáng.", "translation": "Good morning."}, {"text": "Chào buổi tối.", "translation": "Good evening."}, {"text": "Cảm ơn.", "translation": "Thank you."}, {"text": "Không có gì.", "translation": "You're welcome."}, {"text": "Làm ơn.", "translation": "Please."}, {"text": "Vâng.", "translation": "Yes."}, {"text": "Không.", "translation": "No."}, {"text": "Xin lỗi.", "translation": "Excuse me."}, {"text": "Bạn khỏe không?", "translation": "How are you?"}, {"text": "Tôi tên là...", "translation": "My name is..."}, {"text": "Nhà vệ sinh ở đâu?", "translation": "Where is the bathroom?"}, {"text": "Tôi không hiểu.", "translation": "I don't understand."}, {"text": "Tạm biệt.", "translation": "Goodbye."}]