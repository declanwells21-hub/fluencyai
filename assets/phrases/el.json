[{"text": "Γεια σου.", "translation": "Hello."}, {"text": "Καλημέρα.", "translation": "Good morning."}, {"text": "Καλησπέρα.", "translation": "Good evening."}, {"text": "Ευχαριστώ.", "translation": "Thank you."}, {"text": "Παρακαλώ.", "translation": "You're welcome."}, {"text": "Παρακαλώ.", "translation": "Please."}, {"text": "Ναι.", "translation": "Yes."}, {"text": "Όχι.", "translation": "No."}, {"text": "Με συγχωρείτε.", "translation": "Excuse me."}, {"text": "Τι κάνεις;", "translation": "How are you?"}, {"text": "Με λένε...", "translation": "My name is..."}, {"text": "Πού είναι η τουαλέτα;", "translation": "Where is the bathroom?"}, {"text": "Δεν καταλαβαίνω.", "translation": "I don't understand."}, {"text": "Αντίο.", "translation": "Goodbye."}]