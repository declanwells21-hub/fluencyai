[{"text": "สวัสดี", "translation": "Hello."}, {"text": "อรุณสวัสดิ์", "translation": "Good morning."}, {"text": "สวัสดีตอนเย็น", "translation": "Good evening."}, {"text": "ขอบคุณ", "translation": "Thank you."}, {"text": "ยินดี", "translation": "You're welcome."}, {"text": "กรุณา", "translation": "Please."}, {"text": "ใช่", "translation": "Yes."}, {"text": "ไม่", "translation": "No."}, {"text": "ขอโทษ", "translation": "Excuse me."}, {"text": "คุณเป็นอย่างไรบ้าง", "translation": "How are you?"}, {"text": "ฉันชื่อ...", "translation": "My name is..."}, {"text": "ห้องน้ำอยู่ที่ไหน", "translation": "Where is the bathroom?"}, {"text": "ฉันไม่เข้าใจ", "translation": "I don't understand."}, {"text": "ลาก่อน", "translation": "Goodbye."}]