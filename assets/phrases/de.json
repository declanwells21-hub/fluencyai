[{"text": "Hallo.", "translation": "Hello."}, {"text": "Guten Morgen.", "translation": "Good morning."}, {"text": "Guten Abend.", "translation": "Good evening."}, {"text": "Danke.", "translation": "Thank you."}, {"text": "Bitte schön.", "translation": "You're welcome."}, {"text": "Bitte.", "translation": "Please."}, {"text": "Ja.", "translation": "Yes."}, {"text": "Nein.", "translation": "No."}, {"text": "Entschuldigung.", "translation": "Excuse me."}, {"text": "Wie geht es dir?", "translation": "How are you?"}, {"text": "Ich heiße...", "translation": "My name is..."}, {"text": "Wo ist die Toilette?", "translation": "Where is the bathroom?"}, {"text": "Ich verstehe nicht.", "translation": "I don't understand."}, {"text": "Auf Wiedersehen.", "translation": "Goodbye."}]