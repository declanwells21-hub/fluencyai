[{"text": "Здравствуйте.", "translation": "Hello."}, {"text": "Доброе утро.", "translation": "Good morning."}, {"text": "Добрый вечер.", "translation": "Good evening."}, {"text": "Спасибо.", "translation": "Thank you."}, {"text": "Пожалуйста.", "translation": "You're welcome."}, {"text": "Пожалуйста.", "translation": "Please."}, {"text": "Да.", "translation": "Yes."}, {"text": "Нет.", "translation": "No."}, {"text": "Извините.", "translation": "Excuse me."}, {"text": "Как дела?", "translation": "How are you?"}, {"text": "Меня зовут...", "translation": "My name is..."}, {"text": "Где туалет?", "translation": "Where is the bathroom?"}, {"text": "Я не понимаю.", "translation": "I don't understand."}, {"text": "До свидания.", "translation": "Goodbye."}]