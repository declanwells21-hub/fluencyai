[{"text": "Ahoj.", "translation": "Hello."}, {"text": "Dobré ráno.", "translation": "Good morning."}, {"text": "Dobrý večer.", "translation": "Good evening."}, {"text": "Děkuji.", "translation": "Thank you."}, {"text": "Prosím.", "translation": "You're welcome."}, {"text": "Prosím.", "translation": "Please."}, {"text": "Ano.", "translation": "Yes."}, {"text": "Ne.", "translation": "No."}, {"text": "Promiňte.", "translation": "Excuse me."}, {"text": "Jak se máš?", "translation": "How are you?"}, {"text": "Jmenuji se...", "translation": "My name is..."}, {"text": "Kde je záchod?", "translation": "Where is the bathroom?"}, {"text": "Nerozumím.", "translation": "I don't understand."}, {"text": "Na shledanou.", "translation": "Goodbye."}]