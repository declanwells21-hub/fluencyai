[{"text": "Hallo.", "translation": "Hello."}, {"text": "Goedemorgen.", "translation": "Good morning."}, {"text": "Goedenavond.", "translation": "Good evening."}, {"text": "Dank je.", "translation": "Thank you."}, {"text": "Graag gedaan.", "translation": "You're welcome."}, {"text": "Alsjeblieft.", "translation": "Please."}, {"text": "Ja.", "translation": "Yes."}, {"text": "Nee.", "translation": "No."}, {"text": "Pardon.", "translation": "Excuse me."}, {"text": "Hoe gaat het?", "translation": "How are you?"}, {"text": "Ik heet...", "translation": "My name is..."}, {"text": "Waar is het toilet?", "translation": "Where is the bathroom?"}, {"text": "Ik begrijp het niet.", "translation": "I don't understand."}, {"text": "Tot ziens.", "translation": "Goodbye."}]