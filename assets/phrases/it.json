[{"text": "Ciao.", "translation": "Hello."}, {"text": "Buongiorno.", "translation": "Good morning."}, {"text": "Buonasera.", "translation": "Good evening."}, {"text": "Grazie.", "translation": "Thank you."}, {"text": "Prego.", "translation": "You're welcome."}, {"text": "Per favore.", "translation": "Please."}, {"text": "Sì.", "translation": "Yes."}, {"text": "No.", "translation": "No."}, {"text": "Mi scusi.", "translation": "Excuse me."}, {"text": "Come stai?", "translation": "How are you?"}, {"text": "Mi chiamo...", "translation": "My name is..."}, {"text": "Dov'è il bagno?", "translation": "Where is the bathroom?"}, {"text": "Non capisco.", "translation": "I don't understand."}, {"text": "Arrivederci.", "translation": "Goodbye."}]