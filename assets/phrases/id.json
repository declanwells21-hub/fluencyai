[{"text": "Halo.", "translation": "Hello."}, {"text": "Selamat pagi.", "translation": "Good morning."}, {"text": "Selamat malam.", "translation": "Good evening."}, {"text": "Terima kasih.", "translation": "Thank you."}, {"text": "Sama-sama.", "translation": "You're welcome."}, {"text": "Tolong.", "translation": "Please."}, {"text": "Ya.", "translation": "Yes."}, {"text": "Tidak.", "translation": "No."}, {"text": "Permisi.", "translation": "Excuse me."}, {"text": "Apa kabar?", "translation": "How are you?"}, {"text": "Nama saya...", "translation": "My name is..."}, {"text": "Di mana kamar mandi?", "translation": "Where is the bathroom?"}, {"text": "Saya tidak mengerti.", "translation": "I don't understand."}, {"text": "Selamat tinggal.", "translation": "Goodbye."}]