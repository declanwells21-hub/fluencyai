[{"text": "안녕하세요.", "translation": "Hello."}, {"text": "좋은 아침이에요.", "translation": "Good morning."}, {"text": "좋은 저녁이에요.", "translation": "Good evening."}, {"text": "감사합니다.", "translation": "Thank you."}, {"text": "천만에요.", "translation": "You're welcome."}, {"text": "부탁합니다.", "translation": "Please."}, {"text": "네.", "translation": "Yes."}, {"text": "아니요.", "translation": "No."}, {"text": "실례합니다.", "translation": "Excuse me."}, {"text": "어떻게 지내세요?", "translation": "How are you?"}, {"text": "제 이름은...", "translation": "My name is..."}, {"text": "화장실이 어디예요?", "translation": "Where is the bathroom?"}, {"text": "이해가 안 돼요.", "translation": "I don't understand."}, {"text": "안녕히 가세요.", "translation": "Goodbye."}]