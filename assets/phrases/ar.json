[{"text": "مرحبا.", "translation": "Hello."}, {"text": "صباح الخير.", "translation": "Good morning."}, {"text": "مساء الخير.", "translation": "Good evening."}, {"text": "شكرا.", "translation": "Thank you."}, {"text": "عفوا.", "translation": "You're welcome."}, {"text": "من فضلك.", "translation": "Please."}, {"text": "نعم.", "translation": "Yes."}, {"text": "لا.", "translation": "No."}, {"text": "عذرا.", "translation": "Excuse me."}, {"text": "كيف حالك؟", "translation": "How are you?"}, {"text": "اسمي...", "translation": "My name is..."}, {"text": "أين الحمام؟", "translation": "Where is the bathroom?"}, {"text": "لا أفهم.", "translation": "I don't understand."}, {"text": "مع السلامة.", "translation": "Goodbye."}]