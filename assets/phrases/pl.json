[{"text": "Cześć.", "translation": "Hello."}, {"text": "Dzień dobry.", "translation": "Good morning."}, {"text": "Dobry wieczór.", "translation": "Good evening."}, {"text": "Dziękuję.", "translation": "Thank you."}, {"text": "Proszę bardzo.", "translation": "You're welcome."}, {"text": "Proszę.", "translation": "Please."}, {"text": "Tak.", "translation": "Yes."}, {"text": "Nie.", "translation": "No."}, {"text": "Przepraszam.", "translation": "Excuse me."}, {"text": "Jak się masz?", "translation": "How are you?"}, {"text": "Nazywam się...", "translation": "My name is..."}, {"text": "Gdzie jest łazienka?", "translation": "Where is the bathroom?"}, {"text": "Nie rozumiem.", "translation": "I don't understand."}, {"text": "Do widzenia.", "translation": "Goodbye."}]