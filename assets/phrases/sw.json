[{"text": "Habari.", "translation": "Hello."}, {"text": "Habari za asubuhi.", "translation": "Good morning."}, {"text": "Habari za jioni.", "translation": "Good evening."}, {"text": "Asante.", "translation": "Thank you."}, {"text": "Karibu.", "translation": "You're welcome."}, {"text": "Tafadhali.", "translation": "Please."}, {"text": "Ndiyo.", "translation": "Yes."}, {"text": "Hapana.", "translation": "No."}, {"text": "Samahani.", "translation": "Excuse me."}, {"text": "Habari yako?", "translation": "How are you?"}, {"text": "Jina langu ni...", "translation": "My name is..."}, {"text": "Choo kiko wapi?", "translation": "Where is the bathroom?"}, {"text": "Sielewi.", "translation": "I don't understand."}, {"text": "Kwaheri.", "translation": "Goodbye."}]